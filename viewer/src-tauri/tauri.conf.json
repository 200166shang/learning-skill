{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learning Companion",
  "version": "0.1.0",
  "identifier": "com.learningskill.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Learning Map",
        "width": 440,
        "height": 680,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "minimizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"]
  }
}
